{
    "repos": [
        {
            "name": "Novel Fire",
            "idName": "novel-fire",
            "id": "1",
            "repoUrl": "https://novelfire.net",
            "repoType": "novel",
            "repoChapterType": {
                "type": "iterative",
                "path": "/book/[bookId]/chapters"
            },
            "repoIcon": "https://novelfire.net/logo.svg?v=2",
            "repoSearch": {
                "type": "text",
                "method": "GET",
                "path": "/search?title=[text]",
                "selector": ".novel-list .novel-item",
                "page": "search",
                "bookId": {
                    "type": "attribute",
                    "selector": "a",
                    "attribute": "href",
                    "regex": "book/(.*)"
                },
                "rating": {
                    "type": "attribute",
                    "selector": ".novel-stats .info-rating",
                    "attribute": "data-rating"
                },
                "bookLink": {
                    "type": "text",
                    "selector": "a",    
                    "attribute": "href"
                },
                "bookImage": {
                    "type": "text",
                    "selector": ".novel-cover img",
                    "attribute": "src"
                },
                "title": {
                    "type": "text",
                    "selector": ".novel-title"
                }
            },
            "repoTagSearch": {
                "type": "text",
                "method": "GET",
                "path": "/tags/[tag]/order-popular",
                "selector": ".novel-list.grid .novel-item",
                "page": "search",
                "tags": [
                    { "label": "Fanfiction", "value": "fanfiction" },
                    { "label": "Female Protagonist", "value": "female-protagonist" },
                    { "label": "Weak to Strong", "value": "weak-to-strong" },
                    { "label": "Handsome Male Lead", "value": "handsome-male-lead" },
                    { "label": "Male Protagonist", "value": "male-protagonist" },
                    { "label": "Beautiful Female Lead", "value": "beautiful-female-lead" },
                    { "label": "Cultivation", "value": "cultivation" },
                    { "label": "Clever Protagonist", "value": "clever-protagonist" },
                    { "label": "Transmigration", "value": "transmigration" },
                    { "label": "Calm Protagonist", "value": "calm-protagonist" },
                    { "label": "Romantic Subplot", "value": "romantic-subplot" },
                    { "label": "Demons", "value": "demons" },
                    { "label": "Ruthless Protagonist", "value": "ruthless-protagonist" },
                    { "label": "Modern Day", "value": "modern-day" },
                    { "label": "Monsters", "value": "monsters" },
                    { "label": "Game Elements", "value": "game-elements" },
                    { "label": "Cunning Protagonist", "value": "cunning-protagonist" },
                    { "label": "Strong Love Interests", "value": "strong-love-interests" },
                    { "label": "Love Interest Falls in Love First", "value": "love-interest-falls-in-love-first" }
                ],
                "bookId": {
                    "type": "attribute",
                    "selector": "a",
                    "attribute": "href",
                    "regex": "book/(.*)"
                },
                "rating": {
                    "type": "text",
                    "selector": ".badge._br"
                },
                "bookLink": {
                    "type": "text",
                    "selector": "a",
                    "attribute": "href"
                },
                "bookImage": {
                    "type": "text",
                    "selector": ".novel-cover img",
                    "attribute": "data-src"
                },
                "title": {
                    "type": "attribute",
                    "selector": "a",
                    "attribute": "title"
                }
            },
            "homeSelector": {
                "type": "text",
                "path": "/book/[bookId]",
                "page": "home",
                "latestChapterSelector": {
                    "type": "text",
                    "selector": ".novel-info .header-stats span strong"
                },
                "authorSelector": {
                    "type": "text",
                    "selector": ".novel-info .author",
                    "regex": "Author: (.*)"
                },
                "tagsSelector": {
                    "type": "text",
                    "selector": ".categories .property-item"
                },
                "summarySelector": {
                    "type": "text",
                    "selector": ".summary .content"
                }
            },
            "chapterSelector": {
                "path": "/book/[bookId]/chapter-[chapterId]",
                "page": "chapter",
                "content": {
                    "type": "html",
                    "selector": "#chapter-container #content",
                    "filters": [
                        {
                            "type": "css",
                            "selector": ".box-notification"
                        },
                        {
                            "type": "css",
                            "selector": "h4"
                        }
                    ]
                }
            },
            "listSelector": {
                "type": "text",
                "path": "/genre-all/sort-popular/status-all/all-novel",
                "selector": "#list-novel .novel-item",
                "page": "search",
                "bookId": {
                    "type": "attribute",
                    "selector": "a",
                    "attribute": "href",
                    "regex": "book/(.*)"
                },
                "rating": {
                    "type": "attribute",
                    "selector": ".novel-stats .info-rating",
                    "attribute": "data-rating"
                },
                "bookLink": {
                    "type": "text",
                    "selector": "a",
                    "attribute": "href"
                },
                "bookImage": {
                    "type": "text",
                    "selector": ".novel-cover img",
                    "attribute": "data-src"
                },
                "title": {
                    "type": "attribute",
                    "selector": "a",
                    "attribute": "title"
                }
            }
        }
    ]
}
