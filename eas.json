{
  "cli": {
    "version": ">= 12.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "apkPreview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "apkpreview"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "gradleCommand": ":app:bundlePlayRelease",
        "artifactPath": "android/app/build/outputs/bundle/playRelease/app-play-release.aab"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "gradleCommand": ":app:bundlePlayRelease",
        "artifactPath": "android/app/build/outputs/bundle/playRelease/app-play-release.aab"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
